#!/usr/bin/env bash

# Loaded only in human terminals (see .bash_profile).

# `cd` through zoxide, which also jumps to recent directories
alias cd='z'

# Easier navigation
alias ..='cd ..;ls'
alias ...='cd ../..;ls'
alias ....='cd ../../..;ls'
alias .....='cd ../../../..;ls'
alias ......='cd ../../../../..;ls'
alias .......='cd ../../../../../..;ls'

# Color only when writing to a terminal, so pipes stay plain
if ls --version > /dev/null 2>&1; then # GNU `ls`
	alias ls='ls --color=auto'
else # macOS `ls`
	export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'
	alias ls='ls -G'
fi
alias grep='grep --color=auto --exclude-dir=node_modules'

# Enable aliases to be sudo’ed
alias sudo='sudo '

alias tree='tree -CF'
alias password='date +%s | sha256sum | base64 | head -c 32 ; echo'
alias python='python3'
alias c='claude'

# Git
alias g='git'
alias gs='git status'
alias gd='git diff'
alias gca='git commit -am'
alias gch='git checkout'
alias grc='git rebase --continue'
alias gpu='git push -u origin `git name-rev --name-only HEAD`'
alias gpuf='git push -u origin `git name-rev --name-only HEAD` --force-with-lease'
